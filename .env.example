# Copia este archivo a .env en el PC (Escritorio\faenas-app\.env)
# y rellena los valores de Cloudflare R2. No subas .env a git.

OBJECT_STORAGE_BACKEND=r2
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
OBJECT_STORAGE_PUBLIC_BASE_URL=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
